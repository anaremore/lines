/target
/target-*/
# Feed recordings may contain licensed exchange data. Never commit them.
/recordings/
*.lfr
# Sierra Chart data is licensed for personal use only (decision 0010).
*.scid
*.depth
# The local market-data store may hold licensed data (decision 0019): never commit it.
*.lseg
# Fuzz corpora and crash inputs are generated, never committed.
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Python bytecode (the agent guard hook)
__pycache__/

# Update-signing keys (decision 0031): the secret key is the owner's alone and never in a
# repository; the public key is committed in code (`update/verify.rs`), not as a file.
*.key
lines-update.*
